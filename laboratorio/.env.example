# Llave de la API de Anthropic. Para la clase, una sin vencimiento.
ANTHROPIC_API_KEY=
# Solo si la llave es de usuario (sk-ant-usr)
# ANTHROPIC_WORKSPACE_ID=
# Modelos. Por defecto claude-opus-5-5
# ANTHROPIC_MODEL=
# ANTHROPIC_MODEL_CHAT=
# Codigo que se proyecta en la sala
CLASS_CODE=TUNJA26
# Firma de las sesiones del mini registro
SIGNING_SECRET=
# Base de datos Neon (opcional: sin ella los prompts se guardan solo en el navegador)
DATABASE_URL=
